# Copy this file to .env and fill in your own values, then:
#   docker compose up -d
# .env is gitignored - it's the only place your secrets should live.

# Port the panel listens on
PORT=8097

# Home Assistant base URL
HA_URL=http://localhost:8123

# A long-lived Home Assistant access token
HA_TOKEN=

# Your garden's coordinates, e.g. 59.85 / 17.63 - used for the weather
# forecast, frost warning and sun map
GEO_LAT=
GEO_LON=

# ntfy.sh topic for harvest reminders (can also be set later via the gear
# icon in the panel - whichever was set most recently wins)
NTFY_TOPIC=

# Optional Home Assistant webhook URL, sent to in addition to ntfy
WEBHOOK_URL=

# Optional, from console.anthropic.com - enables the AI-driven watering
# insight, AI chat and notification prioritization (otherwise simple
# rule-based fallbacks are used instead)
ANTHROPIC_API_KEY=

# Optional: set this to require a login (one shared household password) to
# use the panel at all. Left blank, no login is required - the default.
APP_PASSWORD=

# Optional, only relevant if APP_PASSWORD is set: comma-separated CIDRs
# (e.g. 192.168.1.0/24) that skip the login. Nothing is trusted by default,
# not even 127.0.0.1 - a reverse proxy on the same host forwards real,
# outside traffic to Growarr over loopback too, so trusting it by default
# would silently let everyone in.
TRUSTED_NETWORKS=
